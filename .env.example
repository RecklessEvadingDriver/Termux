# Environment Variables Configuration

# LLM API Configuration
# You can use different providers - uncomment the one you want to use

# Option 1: Together AI (Recommended for uncensored models)
# Get your API key from https://api.together.xyz/
TOGETHER_API_KEY=your_together_api_key_here
TOGETHER_MODEL=NousResearch/Nous-Hermes-2-Mixtral-8x7B-DPO

# Option 2: Hugging Face Inference API
# Get your API key from https://huggingface.co/settings/tokens
# HUGGINGFACE_API_KEY=your_huggingface_api_key_here
# HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# Option 3: OpenRouter (Multiple uncensored models)
# Get your API key from https://openrouter.ai/
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=gryphe/mythomist-7b

# Provider Selection (together, huggingface, or openrouter)
LLM_PROVIDER=together

# Rate Limiting (requests per minute)
RATE_LIMIT=10

# Maximum response tokens
MAX_TOKENS=512
